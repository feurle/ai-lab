# SMTP settings for send-last. Copy to ${XDG_CONFIG_HOME:-~/.config}/send-last/smtp.conf
# (install-user.sh does this for you) and keep it at mode 600.
#
# Gmail: requires 2-step verification and an app password
# (https://myaccount.google.com/apppasswords), not your normal password.
# Port 587 = STARTTLS, port 465 = implicit SSL.
host = smtp.gmail.com
port = 587
user = your.address@gmail.com
password = APP-PASSWORD
from = Your Name <your.address@gmail.com>
