# Copy to .env and fill in your values. .env is git-ignored.
# The same keys can go in ~/.config/openhab-mcp/.env (user-wide, lower precedence).
OPENHAB_API_TOKEN=your-api-token-here
OPENHAB_BASE_URL=your-openhab-base-url-here
# MCP_TRANSPORT=streamable-http   # streamable-http | sse | stdio
# MCP_HOST=0.0.0.0
# MCP_PORT=8081
